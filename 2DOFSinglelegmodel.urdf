<inertia
ixx="0.000663950610134572"
ixy="9.42170825678126E-10"
ixz="2.33280442142637E-08"
iyy="0.00114524349000934"
iyz="-7.88002117874236E-06"
izz="0.000691045220028636" />
</inertial>
