<robot
name="2DOFSinglelegmodel">
<!-- ===== Vertical slider + upright mount =====
     slider_base (bolted to the ground by fix_base=True)
       └─ pz_z  (prismatic, vertical, no motor)   the leg can only move up and down
           └─ mount_link  (the slider carriage)
               └─ mount_joint (fixed, your rotation)  stands the SolidWorks leg upright
                   └─ base_link -> hip_joint -> knee_joint  (your leg, unchanged) -->
<link
name="slider_base">
<inertial>
<origin
xyz="0 0 0"
rpy="0 0 0" />
<mass
value="1.0" />
<inertia
ixx="0.001"
ixy="0"
ixz="0"
iyy="0.001"
iyz="0"
izz="0.001" />
</inertial>
</link>
<joint
name="pz_z"
type="prismatic">
<!-- z = start height of the carriage above the ground [m] (when pz_z = 0).
     In the starting pose the foot is ~0.25 m below the carriage, so it starts ~0.2 m up and drops. -->
<origin
xyz="0 0 0.35"
rpy="0 0 0" />
<parent
link="slider_base" />
<child
link="mount_link" />
<axis
xyz="0 0 1" />
<!-- travel from the start height: 0.4 m down, 0.3 m up [m] -->
<limit
lower="-0.4"
upper="0.3"
effort="1000"
velocity="20" />
<dynamics
damping="0.01"
friction="0" />
</joint>
<link
name="mount_link">
<inertial>
<origin
xyz="0 0 0"
rpy="0 0 0" />
<!-- carriage mass [kg]: what slides up and down with the leg, besides the leg itself -->
<mass
value="0.3" />
<inertia
ixx="0.0002"
ixy="0"
ixz="0"
iyy="0.0002"
iyz="0"
izz="0.0002" />
</inertial>
</link>
<joint
name="mount_joint"
type="fixed">
<origin
xyz="0 0 0"
rpy="3.14159265 -1.5708 0" />
<parent
link="mount_link" />
<child
link="base_link" />
</joint>
<!-- ===== end of slider + mount ===== -->
<link
name="base_link">
<inertial>
<origin
xyz="1.10401405661875E-06 -0.0217945095493369 0.0585459054905575"
rpy="0 0 0" />
<mass
