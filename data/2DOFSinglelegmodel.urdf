<robot
  name="Final2DOFLeg">
  <!-- ===== Vertical slider + upright mount (added for Isaac Lab) =====
       slider_base (bolted to the ground by fix_base=True)
         └─ pz_z  (prismatic, vertical, no motor)        the leg can only move up and down
             └─ mount_link  (slider carriage)
                 └─ mount_joint (fixed, 180 deg about X)  the SolidWorks export points the leg UP; this flips it down
                     └─ base_link -> hip_joint -> hip_link -> knee_joint -> knee_link -> foot_joint -> foot_link
       Standing pose hip 0.9 / knee 1.4: foot is 0.31 m below the carriage, right under the hip. -->
  <link
    name="slider_base">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="1.0" />
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001" />
    </inertial>
  </link>
  <joint
    name="pz_z"
    type="prismatic">
    <!-- start height of the carriage [m]: standing needs 0.31, so the foot starts ~5 cm up and drops -->
    <origin
      xyz="0 0 0.36"
      rpy="0 0 0" />
    <parent
      link="slider_base" />
    <child
      link="mount_link" />
    <axis
      xyz="0 0 1" />
    <!-- travel from the start height [m]: down 0.30 (deep crouch), up 0.30 (hops) -->
    <limit
      lower="-0.40"
      upper="0.40"
      effort="1000"
      velocity="20" />
    <dynamics
      damping="0.01"
      friction="0" />
  </joint>
  <link
    name="mount_link">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <!-- carriage mass [kg]: what slides with the leg, besides the leg itself -->
      <mass
        value="0.3" />
      <inertia
        ixx="0.0002"
        ixy="0"
        ixz="0"
        iyy="0.0002"
        iyz="0"
        izz="0.0002" />
    </inertial>
  </link>
  <joint
    name="mount_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="3.14159265 0 0" />
    <parent
      link="mount_link" />
    <child
      link="base_link" />
  </joint>
  <!-- ===== end of slider + mount ===== -->
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.00209272945441707 -0.0277965428996201 0.0925222486082806"
        rpy="0 0 0" />
      <mass
        value="1.05333227963718" />
      <inertia
        ixx="0.000663950610918829"
        ixy="9.4219855577499E-10"
