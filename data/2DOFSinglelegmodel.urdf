        iyy="0.0011452434919686"
        iyz="-7.88002131246359E-06"
        izz="0.000691045221300687" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
